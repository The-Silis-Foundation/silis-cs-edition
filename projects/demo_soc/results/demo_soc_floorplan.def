VERSION 5.8 ;
DIVIDERCHAR "/" ;
BUSBITCHARS "[]" ;
DESIGN demo_soc ;
UNITS DISTANCE MICRONS 1000 ;

DIEAREA ( 0 0 ) ( 2500000 2500000 ) ;

COMPONENTS 1 ;
  - u_ram sram + FIXED ( 100000 100000 ) R0 ;
END COMPONENTS

PINS 1 ;
  - clk + NET clk + DIRECTION INPUT + USE SIGNAL + PLACED ( 500000 0 ) N ;
END PINS

END DESIGN
