{
  "name": "Silis CS Edition",
  "image": "mcr.microsoft.com/devcontainers/universal:2",
  "forwardPorts": [8765],
  "portsAttributes": {
    "8765": {
      "label": "Silis Native CAD Web Hub (Schematic, Waveforms & Web FPS)",
      "onAutoForward": "silent",
      "visibility": "public"
    }
  },
  "customizations": {
    "vscode": {
      "settings": {
        "workbench.startupEditor": "readme",
        "python.defaultInterpreterPath": "/opt/silis/runtime/opt/python/bin/python3",
        "files.associations": {
          "*.v": "systemverilog",
          "*.sv": "systemverilog",
          "*.svh": "systemverilog",
          "*.vh": "systemverilog"
        }
      },
      "extensions": [
        "${containerWorkspaceFolder}/extension/silis-cad-workbench-1.0.0.vsix",
        "mshr-h.VerilogHDL"
      ]
    }
  },
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "postStartCommand": "bash .devcontainer/launch_servers.sh || true"
}
