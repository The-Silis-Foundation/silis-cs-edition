{
  "name": "Silis CS Edition",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "features": {
    "ghcr.io/devcontainers/features/sshd:1": {
      "version": "latest"
    }
  },
  "containerEnv": {
    "DISPLAY": ":1",
    "LIBGL_ALWAYS_SOFTWARE": "1",
    "QT_QPA_PLATFORM": "xcb",
    "PDK_ROOT": "${containerWorkspaceFolder}/assets/pdk",
    "PYTHONPATH": "${containerWorkspaceFolder}:${containerWorkspaceFolder}/silis:${containerWorkspaceFolder}/silis/core",
    "LD_LIBRARY_PATH": "/opt/silis/runtime/usr/lib/x86_64-linux-gnu:/opt/silis/runtime/opt/python/lib"
  },
  "portsAttributes": {
    "5900": {
      "onAutoForward": "ignore"
    },
    "5901": {
      "onAutoForward": "ignore"
    }
  },
  "customizations": {
    "vscode": {
      "settings": {
        "workbench.startupEditor": "readme",
        "python.defaultInterpreterPath": "/opt/silis/runtime/opt/python/bin/python3",
        "files.associations": {
          "*.v": "systemverilog",
          "*.sv": "systemverilog",
          "*.svh": "systemverilog",
          "*.vh": "systemverilog"
        }
      },
      "extensions": [
        "../extension/silis-cad-workbench-1.0.0.vsix",
        "mshr-h.VerilogHDL"
      ]
    }
  },
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "postStartCommand": "bash .devcontainer/launch_servers.sh || true"
}
