{
  "name": "Silis CS Edition",
  "image": "mcr.microsoft.com/devcontainers/universal:2",
  "forwardPorts": [8765],
  "portsAttributes": {
    "8765": {
      "label": "Silis Native CAD Web Hub (Schematic, Waveforms & Web FPS)",
      "onAutoForward": "openBrowserOnce",
      "visibility": "public"
    }
  },
  "customizations": {
    "vscode": {
      "settings": {
        "workbench.startupEditor": "readme",
        "python.defaultInterpreterPath": "/opt/silis/runtime/opt/python/bin/python3"
      }
    }
  },
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "postStartCommand": "bash .devcontainer/launch_servers.sh || true"
}
