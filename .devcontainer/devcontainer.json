{
  "name": "Silis CS Edition",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "features": {
    "ghcr.io/devcontainers/features/sshd:1": {
      "version": "latest"
    },
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.12",
      "installTools": true
    }
  },
  "forwardPorts": [8765, 6081, 6082, 6084],
  "portsAttributes": {
    "8765": {
      "label": "Silis Native CAD Web Hub (Schematic & Waveforms)",
      "onAutoForward": "silent"
    },
    "6081": {
      "label": "Silis 2D Layout (FastSiliconPeeker)",
      "onAutoForward": "silent"
    },
    "6082": {
      "label": "Silis Frontend Studio & Waveform (SignalPeeker)",
      "onAutoForward": "silent"
    },
    "6084": {
      "label": "Silis Floorplan & Power Studio (FPS)",
      "onAutoForward": "silent"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "eirikpre.systemverilog",
        "mshr-h.VerilogHDL",
        "eamodio.gitlens"
      ],
      "settings": {
        "workbench.editor.showTabs": "multiple",
        "workbench.editor.openSideBySideDirection": "right",
        "workbench.panel.defaultLocation": "bottom",
        "python.defaultInterpreterPath": "/usr/local/python/current/bin/python",
        "files.associations": {
          "*.v": "systemverilog",
          "*.sv": "systemverilog",
          "*.svh": "systemverilog",
          "*.vh": "systemverilog",
          "*.sdc": "tcl",
          "*.upf": "tcl",
          "*.silisproj": "json"
        },
        "workbench.editorAssociations": {
          "*.vcd": "silis.vcdViewer",
          "*.fst": "silis.vcdViewer",
          "structural_*.json": "silis.schematicViewer",
          "*.synth.json": "silis.schematicViewer",
          "*.def": "silis.defViewer",
          "*.gds": "silis.gdsViewer"
        }
      }
    }
  },
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "postStartCommand": "bash .devcontainer/launch_servers.sh",
  "remoteUser": "vscode"
}
