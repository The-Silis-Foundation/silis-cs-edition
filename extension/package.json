{
  "name": "silis-cad-workbench",
  "displayName": "Silis ASIC CAD Workbench",
  "description": "Zero-install cloud EDA workbench for GitHub Codespaces & VS Code Web: DigitalJS schematic viewer, ROHD waveforms, 2D silicon peeker, and floorplanner.",
  "version": "1.0.0",
  "publisher": "the-silis-foundation",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Other",
    "Visualization",
    "Programming Languages"
  ],
  "main": "./extension.js",
  "browser": "./extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "silis-cad-workbench",
          "title": "Silis CAD",
          "icon": "$(circuit-board)"
        }
      ],
      "panel": [
        {
          "id": "silis-waveforms-panel",
          "title": "Silis Waveforms",
          "icon": "$(pulse)"
        }
      ]
    },
    "views": {
      "silis-cad-workbench": [
        {
          "type": "webview",
          "id": "silis-cad-sidebar",
          "name": "CAD Tools & Flow"
        }
      ],
      "silis-waveforms-panel": [
        {
          "type": "webview",
          "id": "silis-bottom-dock",
          "name": "ROHD Waveform Inspector"
        }
      ]
    },
    "customEditors": [
      {
        "viewType": "silis.vcdViewer",
        "displayName": "ROHD Waveform Viewer",
        "selector": [
          {
            "filenamePattern": "*.vcd"
          },
          {
            "filenamePattern": "*.fst"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "silis.schematicViewer",
        "displayName": "DigitalJS Schematic Viewer",
        "selector": [
          {
            "filenamePattern": "structural_*.json"
          },
          {
            "filenamePattern": "*.synth.json"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "silis.defViewer",
        "displayName": "Silis 2D Layout Peeker (DEF)",
        "selector": [
          {
            "filenamePattern": "*.def"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "silis.gdsViewer",
        "displayName": "Silis GDSII Viewer",
        "selector": [
          {
            "filenamePattern": "*.gds"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "silis.openDashboard",
        "title": "Silis: Open ASIC Studio Dashboard",
        "category": "Silis"
      },
      {
        "command": "silis.newProject",
        "title": "Silis: New ASIC Project",
        "category": "Silis"
      },
      {
        "command": "silis.openProject",
        "title": "Silis: Open Project",
        "category": "Silis"
      },
      {
        "command": "silis.refreshReadme",
        "title": "Silis: Refresh Project Dashboard",
        "category": "Silis"
      },
      {
        "command": "silis.openWorkbench",
        "title": "Silis: Open ASIC CAD Workbench Dock",
        "category": "Silis"
      },
      {
        "command": "silis.openSchematic",
        "title": "Silis: Open Schematic Viewer",
        "category": "Silis"
      },
      {
        "command": "silis.openWaveforms",
        "title": "Silis: Open ROHD Waveforms",
        "category": "Silis"
      },
      {
        "command": "silis.openWaveformInBottomDock",
        "title": "Silis: View Waveform in Bottom Dock",
        "category": "Silis"
      },
      {
        "command": "silis.openLayout",
        "title": "Silis: Open 2D Layout Canvas",
        "category": "Silis"
      },
      {
        "command": "silis.openFloorplanner",
        "title": "Silis: Open Floorplan & Power Studio",
        "category": "Silis"
      },
      {
        "command": "silis.openOpenRoadGui",
        "title": "Silis: OpenROAD Native GUI (Physical Layout)",
        "category": "Silis"
      },
      {
        "command": "silis.runSimulation",
        "title": "Silis: Compile & Run Simulation",
        "category": "Silis",
        "icon": "$(play)"
      },
      {
        "command": "silis.runLint",
        "title": "Silis: Lint RTL (Ctrl+L)",
        "category": "Silis",
        "icon": "$(bug)"
      },
      {
        "command": "silis.runSynthesis",
        "title": "Silis: Run Synthesis (Yosys)",
        "category": "Silis"
      },
      {
        "command": "silis.runAll",
        "title": "Silis: Run Full ASIC Tapeout Flow (OpenROAD)",
        "category": "Silis"
      }
    ],
    "keybindings": [
      {
        "command": "silis.runLint",
        "key": "ctrl+l",
        "when": "editorTextFocus"
      }
    ],
    "menus": {
      "editor/title/run": [
        {
          "command": "silis.runSimulation",
          "group": "navigation@1"
        },
        {
          "command": "silis.runLint",
          "group": "navigation@2"
        }
      ],
      "explorer/context": [
        {
          "command": "silis.openWaveformInBottomDock",
          "when": "resourceExtname == .vcd || resourceExtname == .fst",
          "group": "navigation"
        }
      ]
    }
  }
}
