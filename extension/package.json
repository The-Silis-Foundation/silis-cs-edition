{
  "name": "silis-cad-workbench",
  "displayName": "Silis ASIC CAD Workbench",
  "description": "Zero-install cloud EDA workbench for GitHub Codespaces & VS Code Web: DigitalJS schematic viewer, ROHD waveforms, 2D silicon peeker, and floorplanner.",
  "version": "1.0.0",
  "publisher": "the-silis-foundation",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Other",
    "Visualization",
    "Programming Languages"
  ],
  "main": "./extension.js",
  "browser": "./extension.js",
  "scripts": {
    "compile": "node -e \"console.log('Silis CAD Workbench: Extension is pure JS, no compilation step needed.')\""
  },
  "activationEvents": [
    "onStartupFinished",
    "onView:silis-cad-sidebar",
    "onView:silis-bottom-dock",
    "onView:silis-project-tracker",
    "onCommand:silis.openDashboard",
    "onCommand:silis.newProject",
    "onCommand:silis.openProject",
    "onCommand:silis.refreshReadme",
    "onCommand:silis.openWorkbench",
    "onCommand:silis.openSchematic",
    "onCommand:silis.openWaveforms",
    "onCommand:silis.openWaveformInBottomDock",
    "onCommand:silis.openLayout",
    "onCommand:silis.openFloorplanner",
    "onCommand:silis.runSimulation",
    "onCommand:silis.runLint",
    "onCommand:silis.runSynthesis",
    "onCommand:silis.runAll",
    "onCustomEditor:silis.vcdViewer",
    "onCustomEditor:silis.schematicViewer",
    "onCustomEditor:silis.defViewer",
    "onCustomEditor:silis.gdsViewer"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "silis-cad-workbench",
          "title": "Silis CAD",
          "icon": "web/circuit-board.svg"
        }
      ],
      "panel": [
        {
          "id": "silis-state-tracker-panel",
          "title": "Project State Tracker",
          "icon": "web/circuit-board.svg"
        },
        {
          "id": "silis-waveforms-panel",
          "title": "ROHD Wave Viewer",
          "icon": "web/pulse.svg"
        }
      ]
    },
    "views": {
      "silis-cad-workbench": [
        {
          "type": "webview",
          "id": "silis-cad-sidebar",
          "name": "CAD Tools & Flow"
        }
      ],
      "silis-state-tracker-panel": [
        {
          "type": "webview",
          "id": "silis-project-tracker",
          "name": "Physical Design Flow Pipeline"
        }
      ],
      "silis-waveforms-panel": [
        {
          "type": "webview",
          "id": "silis-bottom-dock",
          "name": "ROHD Wave Viewer"
        }
      ]
    },
    "customEditors": [
      {
        "viewType": "silis.vcdViewer",
        "displayName": "ROHD Waveform Viewer",
        "selector": [
          {
            "filenamePattern": "*.vcd"
          },
          {
            "filenamePattern": "*.fst"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "silis.schematicViewer",
        "displayName": "DigitalJS Schematic Viewer",
        "selector": [
          {
            "filenamePattern": "structural_*.json"
          },
          {
            "filenamePattern": "*.synth.json"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "silis.defViewer",
        "displayName": "Silis Native Layout Viewer (DEF)",
        "selector": [
          {
            "filenamePattern": "*.def"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "silis.gdsViewer",
        "displayName": "Silis GDSII Viewer",
        "selector": [
          {
            "filenamePattern": "*.gds"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "silis.openDashboard",
        "title": "Silis: Open ASIC Studio Dashboard",
        "category": "Silis",
        "icon": "$(dashboard)"
      },
      {
        "command": "silis.newProject",
        "title": "Silis: New ASIC Project",
        "category": "Silis",
        "icon": "$(new-folder)"
      },
      {
        "command": "silis.openProject",
        "title": "Silis: Open Project",
        "category": "Silis",
        "icon": "$(folder-opened)"
      },
      {
        "command": "silis.refreshReadme",
        "title": "Silis: Refresh Project Dashboard",
        "category": "Silis",
        "icon": "$(refresh)"
      },
      {
        "command": "silis.openWorkbench",
        "title": "Silis: Open ASIC CAD Workbench Dock",
        "category": "Silis",
        "icon": "$(window)"
      },
      {
        "command": "silis.openSchematic",
        "title": "Silis: Open Schematic Viewer",
        "category": "Silis",
        "icon": "$(circuit-board)"
      },
      {
        "command": "silis.openWaveforms",
        "title": "Silis: Open ROHD Waveforms",
        "category": "Silis",
        "icon": "$(pulse)"
      },
      {
        "command": "silis.openWaveformInBottomDock",
        "title": "Silis: View Waveform in Bottom Dock",
        "category": "Silis",
        "icon": "$(pulse)"
      },
      {
        "command": "silis.openLayout",
        "title": "Silis: Open Native Layout Viewer",
        "category": "Silis",
        "icon": "$(layers)"
      },
      {
        "command": "silis.openNativeLayout",
        "title": "Silis: Open Native Layout Viewer (FastSiliconPeeker / LayerViewerPanel)",
        "category": "Silis",
        "icon": "$(layers)"
      },
      {
        "command": "silis.openFloorplanner",
        "title": "Silis: Open Floorplan & Power Studio",
        "category": "Silis",
        "icon": "$(layout)"
      },
      {
        "command": "silis.runSimulation",
        "title": "Silis: Compile & Run Simulation",
        "category": "Silis",
        "icon": "$(play)"
      },
      {
        "command": "silis.runLint",
        "title": "Silis: Lint RTL (Ctrl+L)",
        "category": "Silis",
        "icon": "$(bug)"
      },
      {
        "command": "silis.openStateTracker",
        "title": "Silis: Open Project State Tracker",
        "category": "Silis",
        "icon": "$(circuit-board)"
      },
      {
        "command": "silis.openSynthConfirm",
        "title": "Silis: Configure & Confirm Synthesis (Yosys)",
        "category": "Silis",
        "icon": "$(gear)"
      },
      {
        "command": "silis.runSynthesis",
        "title": "Silis: Run Synthesis (Yosys)",
        "category": "Silis",
        "icon": "$(gear)"
      },
      {
        "command": "silis.runAll",
        "title": "Silis: Run Full ASIC Tapeout Flow (OpenROAD)",
        "category": "Silis",
        "icon": "$(rocket)"
      }
    ],
    "keybindings": [
      {
        "command": "silis.runLint",
        "key": "ctrl+l",
        "mac": "cmd+l",
        "when": "editorTextFocus"
      },
      {
        "command": "silis.runSimulation",
        "key": "ctrl+shift+r",
        "mac": "cmd+shift+r",
        "when": "editorTextFocus"
      }
    ],
    "menus": {
      "editor/title/run": [
        {
          "command": "silis.runSimulation",
          "group": "navigation@1"
        },
        {
          "command": "silis.runLint",
          "group": "navigation@2"
        }
      ],
      "explorer/context": [
        {
          "command": "silis.openWaveformInBottomDock",
          "when": "resourceExtname == .vcd || resourceExtname == .fst",
          "group": "navigation@1"
        },
        {
          "command": "silis.openLayout",
          "when": "resourceExtname == .def",
          "group": "navigation@2"
        },
        {
          "command": "silis.openSchematic",
          "when": "resourceExtname == .json",
          "group": "navigation@3"
        },
        {
          "command": "silis.runSimulation",
          "when": "resourceExtname == .v || resourceExtname == .sv",
          "group": "navigation@4"
        },
        {
          "command": "silis.runLint",
          "when": "resourceExtname == .v || resourceExtname == .sv",
          "group": "navigation@5"
        }
      ]
    }
  }
}
