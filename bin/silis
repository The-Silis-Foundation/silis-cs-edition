#!/usr/bin/env bash
# ==============================================================================
# Silis CS Edition CLI Launcher
# ==============================================================================
set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

# Resolve runtime python
if [ -x "/opt/silis/runtime/opt/python/bin/python3" ]; then
    PYTHON_EXEC="/opt/silis/runtime/opt/python/bin/python3"
elif command -v python3 &>/dev/null; then
    PYTHON_EXEC="$(command -v python3)"
else
    PYTHON_EXEC="python3"
fi

export PYTHONPATH="${SCRIPT_DIR}:${SCRIPT_DIR}/core:${SCRIPT_DIR}/third-party/siliconcompiler:${PYTHONPATH:-}"
export PATH="${SCRIPT_DIR}/bin:${SCRIPT_DIR}/third-party/bin:${PATH}"
export LIBGL_ALWAYS_SOFTWARE=1

exec "$PYTHON_EXEC" "${SCRIPT_DIR}/silis.py" "$@"
