#!/usr/bin/env bash
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(dirname "$SCRIPT_DIR")"

# Locate runtime Python binary defensively
if [ -x "/opt/silis/runtime/opt/python/bin/python3" ]; then
    PYTHON_BIN="/opt/silis/runtime/opt/python/bin/python3"
elif [ -x "${REPO_ROOT}/dist/silis-python-qt-x86_64.AppImage" ]; then
    PYTHON_BIN="${REPO_ROOT}/dist/silis-python-qt-x86_64.AppImage"
elif [ -x "/usr/local/bin/python3" ]; then
    PYTHON_BIN="/usr/local/bin/python3"
elif [ -x "/usr/bin/python3" ]; then
    PYTHON_BIN="/usr/bin/python3"
else
    PYTHON_BIN="$(which python3 2>/dev/null || which python 2>/dev/null || echo "python3")"
fi

export PYTHONPATH="${REPO_ROOT}:${REPO_ROOT}/core:${REPO_ROOT}/third-party/siliconcompiler:$PYTHONPATH"
export PATH="${REPO_ROOT}/bin:${REPO_ROOT}/third-party/bin:$PATH"
exec "$PYTHON_BIN" "${REPO_ROOT}/silis.py" "$@"
