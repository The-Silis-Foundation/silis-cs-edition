# ========================================================
# In-Memory SDC Constraints for: demo_soc
# Generated by Silis SDCBuilder
# ========================================================
current_design demo_soc

create_clock -name clk -period 10.000 -waveform {0.000 5.000} [get_ports {clk}]

# ==============================================================================
# SDC Constraints for sram_soc_top
# Target Clock: 100 MHz (10.0 ns)
# Technology: SkyWater 130nm (sky130)
# ==============================================================================

# Clock Definition
create_clock -name clk -period 10.000 [get_ports clk]

# Clock Uncertainty and Jitter
set_clock_uncertainty 0.25 [get_clocks clk]
set_clock_transition 0.15 [get_clocks clk]

# Input / Output Timing Budgets
set_input_delay 2.0 -clock clk [get_ports {rst_n inst_valid inst_in[*]}]
set_output_delay 2.0 -clock clk [get_ports {result_out[*] zero_flag sram_data_out[*]}]

# Maximum Transition and Capacitance
set_max_fanout 16 [current_design]
set_max_transition 1.5 [current_design]
