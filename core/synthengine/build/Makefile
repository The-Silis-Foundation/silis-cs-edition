	$(MAKE) $(MAKESILENT) -f CMakeFiles/synth_engine.dir/build.make CMakeFiles/synth_engine.dir/bindings_synth.cpp.i
.PHONY : bindings_synth.cpp.i

bindings_synth.s: bindings_synth.cpp.s
.PHONY : bindings_synth.s

# target to generate assembly for a file
bindings_synth.cpp.s:
	$(MAKE) $(MAKESILENT) -f CMakeFiles/synth_engine.dir/build.make CMakeFiles/synth_engine.dir/bindings_synth.cpp.s
.PHONY : bindings_synth.cpp.s

